{
  "$schema": "https://doklo.dev/template-manifest-v2.json",
  "name": "saas-prd",
  "version": "2.0.0",
  "display_name": {
    "en": "SaaS PRD",
    "ko": "SaaS PRD"
  },
  "description": {
    "en": "Designed Korean SaaS PM PRD format with hero, scenario timeline, type-coded rule cards, and AC cards. Ships its own stylesheet (extends_default_css: false).",
    "ko": "디자인된 한국 SaaS PRD 형식 — hero · 시나리오 timeline · 타입별 컬러 규칙 카드 · AC 카드. 자체 스타일시트 사용 (extends_default_css: false)."
  },
  "author": { "name": "doklo", "url": "https://github.com/mayp-ai/doklo" },
  "license": "MIT",
  "stability": "experimental",
  "audience": { "en": "Product managers, designers, and engineers", "ko": "제품 관리자, 디자이너, 엔지니어" },
  "purpose": { "en": "Organize one feature's context, behavior, rules, and checks as a PRD.", "ko": "하나의 기능 맥락, 동작, 규칙, 확인 기준을 PRD로 정리합니다." },
  "job": { "en": "Align a delivery team on what a feature must do.", "ko": "기능이 해야 할 일을 실행 팀과 합의합니다." },
  "required_input": { "en": "Feature description, actions, business rules, and acceptance criteria", "ko": "기능 설명, 행동, 비즈니스 규칙, 수용 기준" },
  "variables": {},
  "default_format": "markdown",
  "outputs": {
    "markdown": { "entry": "template.md.tpl", "output_path": "{{dok.dok_id}}.md", "source": "markdown" },
    "html": { "entry": "template.html.tpl", "output_path": "{{dok.dok_id}}.html", "source": "html" }
  },
  "scope": "per_dok",
  "supported_locales": ["en", "ko"],
  "default_locale": "ko",
  "extends_default_css": false,
  "strings": {
    "ko": {
      "section_background": "배경",
      "section_goal": "목적",
      "section_users": "사용자",
      "section_scenario": "시나리오",
      "section_fr": "기능 요구사항",
      "section_nfr": "비기능 요구사항",
      "section_exception": "예외 · 엣지 케이스",
      "section_metrics": "성공 지표",
      "section_open_questions": "Open Questions",
      "status_label": "상태",
      "owner_label": "담당",
      "version_label": "버전",
      "tags_label": "태그",
      "no_value": "—",
      "meta_separator": " · ",
      "step_actor": "행위자",
      "step_intent": "행동",
      "step_outcome": "결과",
      "rule_label": "관련 규칙",
      "ac_label": "수용 기준",
      "goal_placeholder": "Hub 스키마에 goal 필드가 아직 없습니다. PM이 이 한 줄을 정의해 주세요.",
      "goal_inferred_label": "추정",
      "empty_pm": "이 섹션은 아직 비어 있습니다. PM이 채워주세요.",
      "footer_note": "현재 Hub 스냅샷 기준이며, 변경 사항은 다시 렌더한 뒤에만 반영됩니다.",
      "stat_steps": "스텝",
      "stat_rules": "규칙",
      "stat_acs": "수용기준",
      "stat_surfaces": "노출 서비스"
    },
    "en": {
      "section_background": "Background",
      "section_goal": "Goal",
      "section_users": "Users",
      "section_scenario": "Scenario",
      "section_fr": "Functional Requirements",
      "section_nfr": "Non-Functional Requirements",
      "section_exception": "Exceptions · Edge Cases",
      "section_metrics": "Success Metrics",
      "section_open_questions": "Open Questions",
      "status_label": "Status",
      "owner_label": "Owner",
      "version_label": "Version",
      "tags_label": "Tags",
      "no_value": "—",
      "meta_separator": " · ",
      "step_actor": "Actor",
      "step_intent": "Action",
      "step_outcome": "Outcome",
      "rule_label": "Related rules",
      "ac_label": "Acceptance Criterion",
      "goal_placeholder": "Hub schema does not yet carry a goal field. PM, please define this in one sentence.",
      "goal_inferred_label": "Inferred",
      "empty_pm": "This section is still empty. PM, please fill in.",
      "footer_note": "Based on the current Hub snapshot; changes appear only after another render.",
      "stat_steps": "Steps",
      "stat_rules": "Rules",
      "stat_acs": "ACs",
      "stat_surfaces": "Surfaces"
    }
  },
  "requires_hub_layers": ["doks"]
}
