<li class="wb-reason wb-reason--{{type}}"><span class="wb-reason-badge" aria-hidden="true"></span><span class="wb-reason-type">{{type_label}}</span><span class="wb-reason-main"><span class="wb-reason-lead">{{lead}}</span><span class="wb-reason-text">{{text}}</span>{{#if roles}}<span class="wb-reason-roles">{{#each roles}}<span class="wb-chip wb-chip--perm">{{role_label this}}</span>{{/each}}</span>{{/if}}{{#if step_label}}<span class="wb-reason-step">{{step_label}}</span>{{/if}}{{#if rule_id}}<span class="wb-reason-rid">{{rid_label}} {{rule_id}}</span>{{/if}}</span></li>
