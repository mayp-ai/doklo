{
  "$schema": "https://doklo.dev/template-manifest-v2.json",
  "name": "feature-spec-xlsx",
  "version": "1.1.0",
  "display_name": {
    "en": "Functional Specification (Excel)",
    "ko": "기능 명세서 (엑셀)"
  },
  "description": {
    "en": "The spreadsheet edition of the functional specification, in the four-sheet form Korean delivery packages take: a feature list (menu group, feature ID and name, summary, actors, services, status, priority, counts, a remarks column for the reviewer), one row per procedure step (actor, action, system response, precondition), one row per business rule (type, rule, applicable roles, related criteria) and one row per acceptance criterion (criterion, related rules, a blank test-result column). Same facts and wording as feature-spec; the traceability matrix for audit stays with rtm-trace.",
    "ko": "기능 명세서의 엑셀 판. 한국 납품 패키지의 네 시트 꼴: 기능목록(구분·기능 ID·기능명·기능 개요·수행 역할·서비스·상태·우선도·단계/규칙/수용 기준 수·비고), 처리절차(단계마다 한 행: 행위자·행동·시스템 반응·선행 조건), 업무규칙(규칙마다 한 행: 유형·내용·적용 역할·관련 수용 기준), 수용기준(기준마다 한 행: 기준·관련 규칙·시험 결과 빈 칸). 사실과 어휘는 feature-spec과 같고, 감리용 요구사항추적표는 rtm-trace가 맡습니다."
  },
  "author": {
    "name": "doklo",
    "url": "https://github.com/mayp-ai/doklo"
  },
  "license": "MIT",
  "stability": "experimental",
  "audience": {
    "en": "Clients, project managers, QA and developers who work the specification in a spreadsheet",
    "ko": "엑셀로 명세를 다루는 발주처 담당자, 프로젝트 관리자, 품질 담당자, 개발자"
  },
  "purpose": {
    "en": "Hand over the feature list, procedures, rules and acceptance criteria as filterable sheets.",
    "ko": "기능 목록·처리 절차·업무 규칙·수용 기준을 필터할 수 있는 시트로 전달합니다."
  },
  "job": {
    "en": "Review, sort and annotate the functional specification in Excel.",
    "ko": "기능 명세를 엑셀에서 검토·정렬·기입합니다."
  },
  "required_input": {
    "en": "Features with descriptions, steps, business rules and acceptance criteria; the IA tree fills the group column, the roles layer the role names",
    "ko": "설명·단계·업무 규칙·수용 기준이 있는 기능. IA 트리가 있으면 구분 열이, 역할 레이어가 있으면 역할명이 채워집니다"
  },
  "variables": {},
  "default_format": "xlsx",
  "outputs": {
    "xlsx": {
      "output_path": "feature-spec.xlsx",
      "source": "binary"
    }
  },
  "renderer": "xlsx",
  "scope": "workspace",
  "supported_locales": [
    "ko",
    "en"
  ],
  "default_locale": "ko",
  "hub_locales": [
    "ko"
  ],
  "requires_hub_layers": [
    "doks"
  ],
