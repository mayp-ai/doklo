{
  "$schema": "https://doklo.dev/template-manifest-v2.json",
  "name": "github-devguide",
  "version": "2.0.1",
  "display_name": {
    "en": "Developer Guide (per-feature Markdown)",
    "ko": "개발자 가이드 (기능별 Markdown)"
  },
  "description": {
    "en": "One Markdown file per feature, written to be read on GitHub during pull-request review: a status line, the behaviour as a step table, the business rules with their types and roles, acceptance checks as a task list, where the code is (linked to the repository when repo_url is set), related features and the recorded history. Also renders as HTML for hosting.",
    "ko": "기능 1건당 Markdown 파일 하나. PR 리뷰 중 GitHub에서 읽히도록 상태 줄, 단계 표로 적은 동작, 유형·대상 역할이 붙은 비즈니스 규칙, 체크리스트로 적은 확인 기준, 코드 위치(repo_url이 있으면 저장소 링크), 관련 기능, 기록된 이력을 담습니다. 호스팅용 HTML로도 렌더됩니다."
  },
  "author": {
    "name": "doklo",
    "url": "https://github.com/mayp-ai/doklo"
  },
  "license": "MIT",
  "stability": "experimental",
  "audience": {
    "en": "Engineers and code reviewers",
    "ko": "엔지니어와 코드 리뷰어"
  },
  "purpose": {
    "en": "Give a reviewer the feature's behaviour, rules, checks and code locations in one page.",
    "ko": "리뷰어에게 기능의 동작·규칙·확인 기준·코드 위치를 한 장으로 전달합니다."
  },
  "job": {
    "en": "Assess feature behaviour and the rules a change must keep during review.",
    "ko": "리뷰 중 기능 동작과 변경이 지켜야 할 규칙을 파악합니다."
  },
  "required_input": {
    "en": "Feature behaviour, rules, checks and source anchors; repo_url turns code locations into links",
    "ko": "기능 동작, 규칙, 확인 기준, 소스 앵커. repo_url이 있으면 코드 위치가 링크가 됩니다"
  },
  "variables": {
    "repo_url": {
      "type": "string",
      "required": false,
      "description": "Repository web URL, e.g. \"https://github.com/acme/shop\". Code locations link to <repo_url>/blob/<repo_ref>/<file>. Without it, links are root-relative (\"/lib/x.ts\"), which GitHub resolves inside the same repository."
    },
    "repo_ref": {
      "type": "string",
      "required": false,
      "description": "Branch, tag or commit used in code links.",
      "default": "HEAD"
    },
    "plain_code_paths": {
      "type": "boolean",
      "required": false,
      "description": "Set true to print code locations as plain paths instead of links (for a page hosted outside the repository without repo_url).",
      "default": false
    }
  },
  "default_format": "markdown",
  "outputs": {
    "markdown": {
      "entry": "template.md.tpl",
      "output_path": "{{dok.dok_id}}.md",
      "source": "markdown"
    },
    "html": {
      "entry": "template.md.tpl",
      "output_path": "{{dok.dok_id}}.html",
      "source": "markdown"
    }
  },
  "partials": {
    "status-label": "partials/status-label.tpl",
    "rule-type-label": "partials/rule-type-label.tpl",
    "impact-label": "partials/impact-label.tpl",
    "blast-label": "partials/blast-label.tpl",
    "code-link": "partials/code-link.tpl",
    "impact-sentence": "partials/impact-sentence.tpl",
    "blast-sentence": "partials/blast-sentence.tpl"
  },
  "scope": "per_dok",
  "supported_locales": [
    "en",
    "ko"
  ],
  "default_locale": "en",
  "extends_default_css": true,
  "strings": {
    "en": {
      "meta_status": "Status",
      "meta_surfaces": "Surfaces",
      "meta_priority": "Priority",
      "meta_version": "Version",
      "meta_tags": "Tags",
      "meta_id": "Dok ID",
      "meta_updated": "First recorded change",
      "section_behavior": "Behavior",
      "col_step": "#",
      "col_actor": "Actor",
      "col_action": "Does",
      "col_outcome": "Result",
      "col_platforms": "Platforms",
      "precondition": "Requires",
      "system_actor": "System",
      "section_rules": "Rules",
      "col_rule_id": "ID",
      "col_rule_type": "Type",
      "col_rule": "Rule",
      "col_roles": "Applies to",
      "col_code": "Code",
      "roles_all": "all",
